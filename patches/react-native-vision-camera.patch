+package com.margelo.nitro.camera.hybrids.outputs
+
+import android.media.AudioAttributes
+import android.media.MediaActionSound
+import android.media.SoundPool
+import android.util.Log
+import java.io.File
+
+/**
+ * [TikiTaka patch] Plays the same system shutter sound as [MediaActionSound], with the same
+ * audibility-enforced attributes (so it still plays in silent mode where the region requires it),
+ * but at a lower volume. On devices where the shutter sound is enforced (e.g. Korean models),
+ * [MediaActionSound] plays at a fixed full volume that is much louder than the stock camera app.
+ *
+ * Falls back to [MediaActionSound] if the sound file can't be found or hasn't loaded yet.
+ */
+internal class QuietShutterSound {
+  companion object {
+    private const val TAG = "QuietShutterSound"
+
+    // Linear amplitude (0..1). Compare against the stock camera app on a Korean device and adjust.
+    private const val SHUTTER_VOLUME = 0.4f
+
+    // Same lookup as MediaActionSound.
+    private val SOUND_DIRS = listOf("/product/media/audio/ui/", "/system/media/audio/ui/")
+    private const val SHUTTER_FILE = "camera_click.ogg"
+  }
+
+  private val fallback = MediaActionSound()
+  private val soundPool =
+    SoundPool
+      .Builder()
+      .setMaxStreams(1)
+      .setAudioAttributes(
+        AudioAttributes
+          .Builder()
+          .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+          .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+          .setFlags(AudioAttributes.FLAG_AUDIBILITY_ENFORCED)
+          .build(),
+      ).build()
+
+  @Volatile private var soundId = 0
+
+  @Volatile private var isLoaded = false
+
+  fun load(soundName: Int) {
+    fallback.load(soundName)
+    if (soundName != MediaActionSound.SHUTTER_CLICK) return
+
+    val file = SOUND_DIRS.map { File(it, SHUTTER_FILE) }.firstOrNull { it.canRead() }
+    if (file == null) {
+      Log.w(TAG, "$SHUTTER_FILE not found, falling back to MediaActionSound")
+      return
+    }
+    // Only one sound is ever loaded into this pool, so any successful load is ours.
+    soundPool.setOnLoadCompleteListener { _, _, status ->
+      isLoaded = status == 0
+    }
+    soundId = soundPool.load(file.path, 1)
+  }
+
+  fun play(soundName: Int) {
+    if (soundName == MediaActionSound.SHUTTER_CLICK && isLoaded) {
+      // play() returns 0 when it fails, so the shutter sound must still come from the fallback.
+      val streamId = soundPool.play(soundId, SHUTTER_VOLUME, SHUTTER_VOLUME, 1, 0, 1f)
+      if (streamId != 0) return
+    }
+    fallback.play(soundName)
+  }
+}
