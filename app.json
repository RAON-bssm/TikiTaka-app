{
  "expo": {
    "name": "티키타카",
    "slug": "TikiTaka",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/tikitaka-logo.png",
    "scheme": "tikitaka",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/tikitaka.icon",
      "bundleIdentifier": "com.tikitaka.raon",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "동네 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development"
      },
      "associatedDomains": ["applinks:web-view.raon-tikitaka.shop"],
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "64FFS3NVX7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.tikitaka.raon",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "web-view.raon-tikitaka.shop",
              "pathPrefix": "/p/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tikitaka-bg-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FC8253",
          "image": "./assets/images/splash/transparent.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-Bold.ttf",
            "./assets/fonts/OkDanDan-Bold.ttf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "땅따먹기 사진을 본진 구 안에서 찍었는지 확인하기 위해 위치 권한이 필요합니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "사진을 찍을 때 기기 방향에 맞게 사진을 돌리기 위해 동작 센서를 사용합니다."
        }
      ],
      "./plugins/withReleaseSigning",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "게시글 사진을 앨범에 저장하기 위해 사진 추가 권한이 필요합니다.",
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "buildReactNativeFromSource": true
          },
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06b5b7fc-9c3e-4802-89c6-ae6ce7d2b445"
      }
    },
    "owner": "whitebreadcat"
  }
}
