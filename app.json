{
  "expo": {
    "name": "티키타카",
    "slug": "TikiTaka",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/tikitaka-logo.png",
    "scheme": "tikitaka",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/tikitaka.icon",
      "bundleIdentifier": "com.tikitaka.raon",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "동네 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.tikitaka.raon",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tikitaka-bg-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FC8253",
          "image": "./assets/images/splash/transparent.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-Bold.ttf",
            "./assets/fonts/OkDanDan-Bold.ttf"
          ]
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "땅따먹기 사진을 본진 구 안에서 찍었는지 확인하기 위해 위치 권한이 필요합니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06b5b7fc-9c3e-4802-89c6-ae6ce7d2b445"
      }
    },
    "owner": "whitebreadcat"
  }
}
